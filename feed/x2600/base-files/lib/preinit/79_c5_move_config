# shellcheck shell=sh
# shellcheck disable=SC3043,SC1091  # busybox ash supports 'local'; slot.sh is on the target
#
# Runs in the preinit_mount_root hook: the overlay is mounted and / is
# writable. Imports from userdata (stock /usr/data):
#  - opencreator-os/sysupgrade.tgz (stored by platform_copy_config) is moved
#    to /sysupgrade.tgz, which 80_mount_root extracts right after this hook
#    and /etc/init.d/done deletes;
#  - opencreator-os/wifi.conf and opencreator-os/authorized_keys (written by
#    the stock-side installer) when the overlay has no copy yet.

c5_move_config() {
	. /lib/c5/slot.sh
	local dev mnt=/tmp/c5data src
	dev=$(c5_part_dev userdata) || {
		c5_bootlog "move_config: no userdata partition"
		return 0
	}
	mkdir -p "$mnt"
	mount -t ext4 -o rw,noatime "$dev" "$mnt" 2>/dev/null || {
		c5_bootlog "move_config: userdata mount failed"
		return 0
	}
	src=$mnt/opencreator-os
	if [ -f "$src/sysupgrade.tgz" ]; then
		if mv -f "$src/sysupgrade.tgz" /sysupgrade.tgz; then
			c5_bootlog "move_config: sysupgrade.tgz staged for restore"
		else
			c5_bootlog "move_config: moving sysupgrade.tgz failed"
		fi
	fi
	mkdir -p /etc/c5 /etc/dropbear
	if [ -s "$src/wifi.conf" ] && [ ! -s /etc/c5/wifi.conf ]; then
		cp "$src/wifi.conf" /etc/c5/wifi.conf && chmod 600 /etc/c5/wifi.conf
	fi
	if [ -s "$src/authorized_keys" ] && [ ! -s /etc/dropbear/authorized_keys ]; then
		cp "$src/authorized_keys" /etc/dropbear/authorized_keys &&
			chmod 600 /etc/dropbear/authorized_keys
	fi
	sync
	umount "$mnt"
}

boot_hook_add preinit_mount_root c5_move_config
