#!/bin/sh
# shellcheck disable=SC1091

. /lib/functions/uci-defaults.sh

board_config_update

case "$(board_name)" in
flashforge,creator5pro)
	model=$(cut -d' ' -f1 /etc/c5/model 2>/dev/null)
	case "$model" in
		Creator5) ucidef_set_hostname "creator5" ;;
		*) ucidef_set_hostname "creator5pro" ;;
	esac
	;;
esac

board_config_flush

exit 0
