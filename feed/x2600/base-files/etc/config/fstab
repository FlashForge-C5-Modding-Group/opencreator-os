config global
	option anon_swap '0'
	option anon_mount '0'
	option auto_swap '1'
	option auto_mount '1'
	option delay_root '5'
	option check_fs '1'

config mount 'data'
	option label 'c5os'
	option target '/data'
	option fstype 'ext4'
	option options 'rw,noatime'
	option enabled '1'

# Created on c5os by '/etc/init.d/c5-swap create' (run from c5-booted, which
# also turns it on if it is off); block turns it on whenever it mounts /data.
config swap
	option device '/data/swapfile'
	option enabled '1'
