#!/bin/sh /etc/rc.common
# shellcheck disable=SC2034  # START/USE_PROCD are read by /etc/rc.common
# Toggle the PC11 heartbeat GPIO, as stock sys_start.sh does.

START=05
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/c5-heartbeat
	procd_set_param respawn
	procd_set_param stderr 1
	procd_close_instance
}
