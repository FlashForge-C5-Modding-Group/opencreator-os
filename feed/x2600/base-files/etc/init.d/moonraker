#!/bin/sh /etc/rc.common
# shellcheck disable=SC2034  # START/USE_PROCD are read by /etc/rc.common
# Moonraker, from the printer stack in /data/printer (docs/stack.md);
# nothing to start until c5-stack-setup installed it.

START=96
USE_PROCD=1

start_service() {
	[ -x /data/printer/bin/moonraker ] || return 0
	procd_open_instance
	procd_set_param command /data/printer/bin/moonraker
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
