#!/bin/sh /etc/rc.common
# shellcheck disable=SC1091,SC3043,SC2034  # STOP/EXTRA_* are read by /etc/rc.common
#
# Swap file /data/swapfile (256 MiB) on c5os. fstab's 'config swap' section
# turns it on as soon as block mounts /data.
#
# create: run by c5-booted after the health decision on every boot. Writes
# the file once, when it is missing on a mounted c5os, and turns it on;
# skipped (one syslog line) when /data is not c5os or c5os would keep less
# than 64 MiB free. dd writes real zeros (swapon refuses files with holes)
# into swapfile.new; only a finished file gets the final name, so a power
# cut leaves swapfile.new for the next boot to redo. Never fails.
#
# start/stop turn it on/off. stop also runs at shutdown (K89, before
# K90umount): an active swap file keeps c5os from unmounting, which leaves
# it needing journal recovery.

STOP=89
EXTRA_COMMANDS=create
EXTRA_HELP="	create	Create the swap file if it is missing and turn it on"

C5_SWAP_MIB=256
C5_SWAP_SPARE_MIB=64

create() {
	. /lib/c5/slot.sh
	local f="$C5_DATA/swapfile" dev kib need
	[ ! -e "$f" ] || return 0
	if ! dev=$(c5_part_dev c5os) ||
		! awk -v d="$dev" -v m="$C5_DATA" '$1 == d && $2 == m { f = 1 } END { exit !f }' "$C5_MOUNTS"; then
		logger -t c5-swap "no swap file: $C5_DATA is not c5os"
		return 0
	fi
	rm -f "$f.new"
	kib=$(df -Pk "$C5_DATA" | awk 'NR == 2 { print $4 }')
	need=$(((C5_SWAP_MIB + C5_SWAP_SPARE_MIB) * 1024))
	if [ "${kib:-0}" -lt "$need" ]; then
		logger -t c5-swap "no swap file: $((${kib:-0} / 1024)) MiB free on c5os, needs $((need / 1024))"
		return 0
	fi
	if (umask 077 && dd if=/dev/zero of="$f.new" bs=1M count="$C5_SWAP_MIB" conv=fsync 2>/dev/null) &&
		mkswap "$f.new" > /dev/null 2>&1 && sync && mv -f "$f.new" "$f" && sync; then
		if swapon "$f" 2>/dev/null; then
			logger -t c5-swap "created $f ($C5_SWAP_MIB MiB), swap on"
		else
			logger -t c5-swap "created $f ($C5_SWAP_MIB MiB), swapon FAILED"
		fi
	else
		rm -f "$f.new"
		logger -t c5-swap "creating $f FAILED"
	fi
	return 0
}

start() {
	. /lib/c5/slot.sh
	[ ! -f "$C5_DATA/swapfile" ] || swapon "$C5_DATA/swapfile" 2>/dev/null
	return 0
}

stop() {
	. /lib/c5/slot.sh
	swapoff "$C5_DATA/swapfile" 2>/dev/null
	return 0
}
