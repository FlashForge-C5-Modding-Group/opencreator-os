#!/bin/sh
# shellcheck disable=SC1091
# Runs the stick's runFirmwareExe.sh (START=19). While the outcome of an
# installer test boot is open (chainloaded test boot, or last-test still
# "started" after a flip) the hook waits for it: c5-booted runs it again
# with "now" once it decided, so the installer sees the committed result.

. /lib/c5/slot.sh

if [ ! -s "$C5_OCDIR/model" ]; then
	logger -t c5-usb-hook "no stored model; skipping USB hook"
	exit 0
fi
read -r machine pid < "$C5_OCDIR/model"
case "$machine $pid" in
	'Creator5Pro 0029'|'Creator5 0028') ;;
	*) logger -t c5-usb-hook "invalid stored model; skipping USB hook"; exit 0 ;;
esac

if [ "${1:-}" != now ] && { c5_test_boot || grep -q '^started ' "$C5_OCDIR/last-test" 2>/dev/null; }; then
	logger -t c5-usb-hook "test boot outcome pending; USB hook deferred until c5-booted"
	: > /tmp/c5-usb-hook.deferred
	exit 0
fi

mkdir -p /mnt
for dev in /dev/sd[a-z][0-9]* /dev/sd[a-z]; do
	[ -b "$dev" ] || continue
	mount -t vfat -o rw "$dev" /mnt 2>/dev/null || continue
	if [ -f /mnt/runFirmwareExe.sh ]; then
		logger -t c5-usb-hook "running /mnt/runFirmwareExe.sh from $dev"
		sh /mnt/runFirmwareExe.sh "$machine" "$pid" || :
	fi
	umount /mnt || logger -t c5-usb-hook "cannot unmount /mnt"
	exit 0
done
