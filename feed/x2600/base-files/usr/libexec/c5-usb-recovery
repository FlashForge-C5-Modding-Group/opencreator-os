#!/bin/sh
# shellcheck disable=SC1091,SC3043
#
# USB recovery hook on the OpenWrt side, run once per boot by
# /etc/init.d/c5-usb-recovery (the counterpart of stock's runFirmwareExe.sh
# hook). If a FAT USB stick holds opencreator-os-recovery/restore.conf, the
# first non-comment line of that file is performed:
#
#   boot-stock                   next boot: the stock slot
#   restore-stock                write kernel.img + rootfs.squashfs into the
#                                stock slot, from the stick directory or, if
#                                it has neither, from /data/opencreator-os/stock
#   restore-partition usershare  write usershare.img into usershare
#
# Images are checked against SHA256SUMS (or MD5SUMS) next to them, written,
# and read back. The slot OpenWrt runs from is never written. Progress goes
# to opencreator-os-recovery/result.log on the stick. On success restore.conf
# becomes restore.done, the boot flag points at stock and the printer
# reboots. On failure restore.conf becomes restore.failed, the flag points
# at this slot (or stays where it was if nothing was written) and OpenWrt
# keeps booting. Either way a stick left plugged in does nothing next time.
#
# Test overrides: C5_REC_DEVS, C5_REC_MNT, C5_REC_WAIT, C5_REC_GRACE,
# C5_USBSYS, plus those of /lib/c5/slot.sh.

. /lib/c5/slot.sh
. /lib/c5/restore.sh

DEVS=${C5_REC_DEVS:-/dev/sd[a-z]1 /dev/sd[a-z]}
MNT=${C5_REC_MNT:-/tmp/c5-recovery}
WAIT=${C5_REC_WAIT:-15}
GRACE=${C5_REC_GRACE:-3}
USBSYS=${C5_USBSYS:-/sys/bus/usb/devices}
REC=opencreator-os-recovery

candidates() {
	local d
	# shellcheck disable=SC2086  # DEVS holds glob patterns
	for d in $DEVS; do
		[ -e "$d" ] && echo "$d"
	done
}

# A USB mass-storage interface (class 08) is present.
mass_storage() {
	local f
	for f in "$USBSYS"/*/bInterfaceClass; do
		[ "$(cat "$f" 2>/dev/null)" = 08 ] && return 0
	done
	return 1
}

# Wait up to $WAIT s for a disk; give up after $GRACE s if no USB storage
# interface has shown up at all, so boots without a stick are not delayed.
wait_for_disk() {
	local t=0
	while [ -z "$(candidates)" ]; do
		[ "$t" -lt "$WAIT" ] || return 1
		[ "$t" -lt "$GRACE" ] || mass_storage || return 1
		sleep 1
		t=$((t + 1))
	done
	[ "$t" = 0 ] || sleep 1	# a disk that just appeared: let its partitions follow
}

# Mount the first candidate holding $REC/restore.conf at $MNT; sets DEV.
find_request() {
	local d
	mkdir -p "$MNT"
	for d in $(candidates); do
		mount -t vfat "$d" "$MNT" 2>/dev/null || continue
		if [ -f "$MNT/$REC/restore.conf" ]; then
			DEV=$d
			return 0
		fi
		umount "$MNT"
	done
	return 1
}

log() {
	echo "$(date '+%F %T') $*" >> "$LOG"
	echo "c5-usb-recovery: $*"
}

# done|failed MESSAGE: record the outcome, retire restore.conf, unmount.
finish() {
	local state="$1"
	shift
	log "$*"
	mv -f "$R/restore.conf" "$R/restore.$state" || log "warning: could not rename restore.conf to restore.$state"
	c5_bootlog "usb-recovery: $state: $*"
	if c5_is_mountpoint "$C5_DATA"; then
		mkdir -p "$C5_OCDIR/logs" && cp "$LOG" "$C5_OCDIR/logs/recovery-last.log"
	fi
	sync
	umount "$MNT"
}

# Perform the request in "$@"; on failure C5_WHY says why.
act() {
	local src
	case "$1" in
		boot-stock)
			[ $# = 1 ] || { c5_why "usage: boot-stock"; return 1; }
			c5_slot_bootable "$OTHER" ||
				{ c5_why "stock slot $OTHER does not look bootable (kernel not a uImage or rootfs not squashfs)"; return 1; }
			;;
		restore-stock)
			[ $# = 1 ] || { c5_why "usage: restore-stock"; return 1; }
			src=$R
			[ -e "$R/kernel.img" ] || [ -e "$R/rootfs.squashfs" ] || src=$C5_OCDIR/stock
			log "restore-stock: images from $src"
			c5_restore_stock "$src" 0 >> "$LOG" 2>&1
			;;
		restore-partition)
			[ $# = 2 ] || { c5_why "usage: restore-partition usershare"; return 1; }
			c5_restore_partition "$2" "$R" 0 >> "$LOG" 2>&1
			;;
		*)
			c5_why "unknown request '$*' (expected boot-stock, restore-stock or restore-partition usershare)"
			return 1
			;;
	esac
}

wait_for_disk || exit 0
find_request || exit 0
R=$MNT/$REC
LOG=$R/result.log

req=$(tr -d '\r' < "$R/restore.conf" | sed -e 's/#.*//' -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' | grep -m 1 .)
log "request '$req' on $DEV"
if ! OWN=$(c5_own_slot); then
	finish failed "FAILED: root $(c5_root_dev) is not an eMMC slot; nothing done"
	exit 1
fi
OTHER=$(c5_other_slot)
log "running slot $OWN, stock slot $OTHER, boot flag '$(c5_flag_read)'"

C5_WHY=
set -f
# shellcheck disable=SC2086  # split the request into words
set -- $req
set +f
if ! act "$@"; then
	finish failed "FAILED: ${C5_WHY:-see above}; boot flag '$(c5_flag_read)'; OpenWrt keeps booting"
	exit 1
fi
if ! c5_flag_write "$OTHER"; then
	finish failed "FAILED: $1 done, but pointing the boot flag at stock failed (flag '$(c5_flag_read)'); OpenWrt keeps booting"
	exit 1
fi
: > "$C5_REBOOT_MARK"
finish 'done' "OK: $req; next boot: slot $OTHER (stock); rebooting"
reboot
exit 0
