#!/bin/sh
# shellcheck disable=SC1091,SC3043
#
# c5-restore-stock [--dry-run] [--reboot] [DIR]
#
# Rewrite the stock kernel and rootfs saved by the installer (default DIR:
# the saved copy on userdata (stock's /usr/data/opencreator-os/stock),
# mounted read-only for the run; kernel.img, rootfs.squashfs, SHA256SUMS or
# MD5SUMS) into the slot this system is NOT running from (the stock slot).
# While it writes, the boot flag points at this slot and stock is marked
# invalid; --reboot then points the flag at the stock slot and reboots
# (refused if stock is still not selectable). The last line printed is
# "restore: OK..." or "restore: FAILED <why>".

. /lib/c5/slot.sh
. /lib/c5/restore.sh

DRY=0
REBOOT=0
DIR=

while [ $# -gt 0 ]; do
	case "$1" in
		--dry-run) DRY=1 ;;
		--reboot) REBOOT=1 ;;
		-h|--help)
			sed -n '4,13s/^# \{0,1\}//p' "$0"
			exit 0
			;;
		-*) echo "restore: FAILED unknown option $1"; exit 2 ;;
		*) DIR=$1 ;;
	esac
	shift
done

fail() {
	echo "restore: FAILED $*"
	c5_bootlog "restore-stock: FAILED $*"
	exit 1
}

# Writes the stock slot from $DIR (C5_WHY says why on failure).
c5_restore_stock_main() {
	c5_restore_stock "$DIR" "$DRY"
}

C5_WHY=
if [ -n "$DIR" ]; then
	c5_restore_stock_main || fail "$C5_WHY"
else
	DIR=$C5_UDATA/opencreator-os/stock
	c5_with_part userdata "$C5_UDATA" ro,noload c5_restore_stock_main ||
		fail "${C5_WHY:-cannot mount userdata at $C5_UDATA}"
fi
slot=$C5_STOCK_SLOT

if [ "$DRY" = 1 ]; then
	echo "restore: OK (dry run)"
	exit 0
fi
c5_bootlog "restore-stock: slot $slot written and verified from $DIR"

if [ "$REBOOT" = 1 ]; then
	if why=$(c5_stock_blocker); then
		echo "restore: OK, but not rebooting into stock: $why; boot flag stays on this slot"
		exit 1
	fi
	c5_flag_write "$slot" || fail "written and verified, but the boot flag write failed"
	echo "restore: OK; flag -> slot $slot, rebooting"
	sync
	reboot
	exit 0
fi
echo "restore: OK; boot flag stays on this slot (boot stock with: c5-slot boot-stock --reboot)"
