CONFIG_TARGET_x2600=y
CONFIG_TARGET_x2600_generic=y
CONFIG_TARGET_x2600_generic_DEVICE_flashforge_creator5pro=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
# CONFIG_TARGET_ROOTFS_INITRAMFS is not set
# Stable image names (no version in the file name); the version is the
# artifact directory name.
# CONFIG_VERSION_FILENAMES is not set
# CONFIG_TARGET_ROOTFS_EXT4FS is not set
# CONFIG_TARGET_ROOTFS_TARGZ is not set
CONFIG_DEVEL=y
CONFIG_CCACHE=y
CONFIG_IMAGEOPT=y
# CONFIG_PER_FEED_REPO is not set
CONFIG_VERSIONOPT=y
CONFIG_VERSION_DIST="opencreator-os"
CONFIG_VERSION_HOME_URL="https://github.com/FlashForge-C5-Modding-Group/opencreator-os"
CONFIG_PACKAGE_wpad-basic-mbedtls=y
CONFIG_PACKAGE_kmod-rtw88-8821cu=y
CONFIG_PACKAGE_rtl8821ce-firmware=y
# The vendor kernel tree has warnings that -Werror turns into failures.
# CONFIG_KERNEL_WERROR is not set
# OpenWrt kernel defaults turned off: Multipath TCP (unused), and RT group
# scheduling (with it, a SCHED_FIFO task in a non-root cpu cgroup gets no
# realtime runtime unless one is assigned).
# CONFIG_KERNEL_MPTCP is not set
# CONFIG_KERNEL_RT_GROUP_SCHED is not set
