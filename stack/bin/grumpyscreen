#!/bin/sh
# GrumpyScreen on the panel, run by /etc/init.d/grumpyscreen.
# shellcheck source-path=SCRIPTDIR source=env.sh
. "$(dirname "$0")/env.sh"
# a stick's installer owns the screen while it holds the USB hook lock
exec 9> /tmp/c5-usb-hook.lock
flock 9
exec 9>&-
# keep the kernel console's text and cursor off the screen (as the stick's
# runFirmwareExe.sh does for the installer app)
for v in /sys/class/vtconsole/vtcon*; do
	grep -q 'frame buffer' "$v/name" 2> /dev/null && echo 0 > "$v/bind"
done
TOUCH=$(awk '
	/^N: Name=/ { name = tolower($0) }
	/^H: Handlers=/ && name ~ /goodix|touch/ {
		for (i = 2; i <= NF; i++)
			if ($i ~ /^event[0-9]+$/) { print "/dev/input/" $i; exit }
	}' /proc/bus/input/devices 2> /dev/null)
export LVGL_EVDEV_DEV="${TOUCH:-/dev/input/event2}"
export CONFIG_FILE=/data/printer_data/config/grumpyscreen.cfg
exec "$P/grumpyscreen/grumpyscreen"
