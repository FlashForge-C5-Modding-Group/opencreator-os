From: opencreator-os
Subject: [PATCH] backports: build genetlink compat on 6.6 before 6.6.58

Patch 300 declares backport_genlmsg_multicast_allns() for 6.6.0-6.6.58 and
guards its body with the same range, but compat/Makefile only builds
backport-genetlink.o for kernels older than 6.1. The Ingenic X2600 SDK
kernel is 6.6.18, so cfg80211.ko ends up with an undefined symbol.

Build the object for 6.1 <= kernel < 6.7; older kernels already get it
from the KERNEL_5_15/KERNEL_6_1 lines, so the object is listed once.

--- a/compat/Makefile
+++ b/compat/Makefile
@@ -20,5 +20,10 @@ compat-$(CPTCFG_KERNEL_5_15) += backport
 compat-$(CPTCFG_KERNEL_6_1) += backport-genetlink.o
 compat-$(CPTCFG_KERNEL_6_4) += backport-6.4.o
 compat-$(CPTCFG_KERNEL_6_11) += backport-6.11.o
+ifneq ($(CPTCFG_KERNEL_6_7),)
+ifeq ($(CPTCFG_KERNEL_6_1),)
+compat-y += backport-genetlink.o
+endif
+endif
 
 compat-$(CPTCFG_BPAUTO_BUILD_CRYPTO_LIB_ARC4) += lib-crypto-arc4.o
