# Kconfig fragment merged onto Linux 6.6 malta_defconfig for the QEMU system
# tests (test/qemu). Everything a test boot needs is built in: the OpenWrt
# root's kernel modules are for the X2600 kernel and never load here, and the
# stock root has no modules for this kernel either. The exception is the USB
# Ethernet driver below.

# CPU / ABI: little-endian MIPS32r2 kernel, run on QEMU's 24Kf. FP64 support
# lets the stock FP64 userland run; ieee754=relaxed on the command line lets
# the stock NaN2008 and OpenWrt legacy-NaN binaries run on the same CPU.
CONFIG_CPU_LITTLE_ENDIAN=y
CONFIG_CPU_MIPS32_R2=y
CONFIG_MIPS_O32_FP64_SUPPORT=y
CONFIG_HZ_100=y
# Same as the product kernel: reboot 10 s after a panic (QEMU runs with
# -no-reboot, so a panic ends the run instead of looping).
CONFIG_PANIC_TIMEOUT=10
CONFIG_PRINTK_TIME=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# Emulated eMMC: SD card on a PCI SDHCI controller -> /dev/mmcblk0p1..p7
CONFIG_PCI=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_BLOCK_MINORS=16
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PCI=y
CONFIG_PARTITION_ADVANCED=y
CONFIG_EFI_PARTITION=y
CONFIG_MSDOS_PARTITION=y

# USB stick: qemu-xhci + usb-storage -> /dev/sda1 (UHCI kept for reference
# boots; xHCI gives the stick enough speed for S12's whole-eMMC backup)
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_UHCI_HCD=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_STORAGE=y

# USB Ethernet adapter (S16, QEMU usb-net): built as modules (kernel/build.sh
# builds usbnet.ko and cdc_ether.ko, the harness puts them into the OpenWrt
# root) so the image's own kmod-usb-net autoload entries load them, as on the
# printer. Without the RNDIS host driver the kernel picks usb-net's CDC
# Ethernet configuration.
CONFIG_USB_USBNET=m
CONFIG_USB_NET_CDCETHER=m
# CONFIG_USB_NET_RNDIS_HOST is not set

# File systems
CONFIG_BLK_DEV_LOOP=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_FILE_DIRECT=y
CONFIG_SQUASHFS_XATTR=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_LZO=y
CONFIG_SQUASHFS_ZLIB=y
CONFIG_EXT4_FS=y
# CONFIG_EXT2_FS is not set
# CONFIG_EXT3_FS is not set
CONFIG_EXT4_USE_FOR_EXT2=y
CONFIG_OVERLAY_FS=y
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_IOCHARSET="utf8"
CONFIG_NLS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_CODEPAGE_936=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BLK_DEV_INITRD=y

# Userspace needs (procd/ubus, busybox init)
CONFIG_UNIX=y
CONFIG_INOTIFY_USER=y
CONFIG_FHANDLE=y
CONFIG_SYSVIPC=y

# Console, network, power-off
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_PCNET32=y
CONFIG_POWER_RESET=y
CONFIG_POWER_RESET_PIIX4_POWEROFF=y

# OpenWrt puts "lan" in bridge br-lan, and netifd always sends
# IFLA_BR_VLAN_FILTERING, which a kernel without BRIDGE_VLAN_FILTERING
# rejects (no br-lan, no address). Same as the product kernel (e053613).
CONFIG_BRIDGE=y
CONFIG_VLAN_8021Q=y
CONFIG_BRIDGE_VLAN_FILTERING=y
