# /etc/inittab of the QEMU test copy of the stock root (stock busybox init).
# The sysinit lines are stock's own; rcS (hardware drivers, network, adb,
# factory test) and the console getty are replaced by /qemu-stock-init, which
# mounts like stock and runs stock's USB hook (app_startup.sh), and by
# /qemu-stock-finish, which powers off when nothing asked for a reboot.
::sysinit:/bin/mount -t tmpfs tmpfs /dev
::sysinit:/bin/mknod /dev/null c 1 3
::sysinit:/bin/mount -t proc proc /proc
::sysinit:/bin/mkdir -p /dev/pts /dev/shm
::sysinit:/bin/mount -a
null::sysinit:/bin/ln -sf /proc/self/fd /dev/fd
null::sysinit:/bin/ln -sf /proc/self/fd/0 /dev/stdin
null::sysinit:/bin/ln -sf /proc/self/fd/1 /dev/stdout
null::sysinit:/bin/ln -sf /proc/self/fd/2 /dev/stderr
::sysinit:/bin/hostname -F /etc/hostname
::sysinit:/qemu-stock-init
::once:/qemu-stock-finish
::shutdown:/bin/echo QEMU-STOCK-SHUTDOWN
::shutdown:/bin/umount -a -r
