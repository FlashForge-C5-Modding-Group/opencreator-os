# FlashForge Creator 5 Pro fragment, merged onto the Ingenic SDK
# x2600_halley7_linux_defconfig with scripts/kconfig/merge_config.sh
# (kernel/mkconfig.sh). Source of intent for feed/x2600/config-6.6.

# --- Board / device tree (built in; the SPL passes no DTB) ---
# CONFIG_DT_X2600_HALLEY7 is not set
CONFIG_DT_X2600_MODULE_BASE=y
CONFIG_DT_X2600_MODULE_BASE_DTS_FILE="x2600/creator5pro.dts"
CONFIG_INGENIC_BUILTIN_DTB=y
CONFIG_BUILTIN_DTB=y
CONFIG_MIPS_NO_APPENDED_DTB=y

# --- Command line: built-in prefix + the SPL's argv ---
# ieee754=relaxed lets legacy-NaN userland run on the XBurst2 FPU.
CONFIG_CMDLINE_BOOL=y
CONFIG_CMDLINE="ieee754=relaxed"
CONFIG_MIPS_CMDLINE_BUILTIN_EXTEND=y
# CONFIG_CMDLINE_OVERRIDE is not set

CONFIG_LOCALVERSION="-c5pro"
# CONFIG_LOCALVERSION_AUTO is not set

# --- CPU / timing (SPL passes a fixed lpj for HZ=100) ---
CONFIG_SMP=y
CONFIG_NR_CPUS=2
CONFIG_HZ_100=y
CONFIG_HIGHMEM=y
CONFIG_MIPS_O32_FP64_SUPPORT=y
CONFIG_PANIC_TIMEOUT=10

# --- Root: squashfs on an eMMC slot, OpenWrt overlay through a loop device ---
# CONFIG_BLK_DEV_INITRD is not set
CONFIG_BLK_DEV_LOOP=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_FILE_DIRECT=y
CONFIG_SQUASHFS_XATTR=y
CONFIG_SQUASHFS_ZLIB=y
CONFIG_SQUASHFS_LZO=y
CONFIG_SQUASHFS_XZ=y
CONFIG_OVERLAY_FS=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_USE_FOR_EXT2=y
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_IOCHARSET="utf8"
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_CODEPAGE_936=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
# Klipper/pyserial need flock(); the SDK defconfig has it off.
CONFIG_FILE_LOCKING=y
CONFIG_LOG_BUF_SHIFT=17
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_PRINTK_TIME=y

# --- eMMC / USB ---
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI_INGENIC=y
CONFIG_USB=y
CONFIG_USB_DWC2=y
CONFIG_USB_DWC2_DUAL_ROLE=y
CONFIG_USB_STORAGE=y

# --- Wi-Fi comes from OpenWrt's mac80211 backports (kmod-rtw88-8821cu) ---
CONFIG_WLAN=y
# CONFIG_CFG80211 is not set
# CONFIG_MAC80211 is not set
# The dev board's Broadcom SDIO Wi-Fi is not on this board.
# CONFIG_BCMDHD is not set

# --- GPIO, regulators, watchdog, input ---
CONFIG_GPIO_SYSFS=y
CONFIG_GPIO_CDEV=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_WATCHDOG=y
CONFIG_INGENIC_WDT=y
CONFIG_INPUT_EVDEV=y

# --- Not in this milestone: display, the RISC-V core (RTOS started by SPL) ---
# CONFIG_FB is not set
# CONFIG_REMOTEPROC is not set
# GT9xx touch is the later display/touch milestone (the SDK driver also
# fails to build with GCC 12+ -Werror=uninitialized).
# CONFIG_TOUCHSCREEN_GT9XX is not set
# Dev-board features this board does not use: CAN, Ethernet (no MAC node),
# the SDK camera/codec media stack (webcams are a later milestone).
# (SOUND stays: an SDK option selects it.)
# CONFIG_CAN is not set
# CONFIG_INGENIC_MAC is not set
# CONFIG_MEDIA_SUPPORT is not set
