From: OpenCreator
Subject: [PATCH] fbdev: ingenic: bring up the Creator5Pro KX070 panel

Register the always-powered 480x800 LVDS panel using stock 45 Hz timings,
VESA 24-bit mapping and zero signal polarities. Keep the supported 30 MHz
PHY/EPLL lookup separate from the active mode's DPU clock request.

Carry the X2600 cold-start LPCDR handshake and prevent fbcon from starting
RDMA before display setup. No panel init blob or power GPIOs are needed.

---
diff --git a/module_drivers/drivers/video/fbdev/ingenic/displays/Kconfig b/module_drivers/drivers/video/fbdev/ingenic/displays/Kconfig
--- a/module_drivers/drivers/video/fbdev/ingenic/displays/Kconfig
+++ b/module_drivers/drivers/video/fbdev/ingenic/displays/Kconfig
@@ -5,5 +5,12 @@
 	select LCD_CLASS_DEVICE
 	select BACKLIGHT_CLASS_DEVICE
+
+config STAGE_KX070
+	tristate "Creator5Pro KX070 LVDS panel"
+	depends on FB_INGENIC_DISPLAYS_STAGE && FB_INGENIC_STAGE && SOC_X2600
+	help
+	  Native 480x800, 45 Hz KX070 panel on the FlashForge Creator5Pro.
+	  The panel is always powered; its backlight is controlled separately.
 
 
 config STAGE_Y88249
diff --git a/module_drivers/drivers/video/fbdev/ingenic/displays/Makefile b/module_drivers/drivers/video/fbdev/ingenic/displays/Makefile
--- a/module_drivers/drivers/video/fbdev/ingenic/displays/Makefile
+++ b/module_drivers/drivers/video/fbdev/ingenic/displays/Makefile
@@ -1,3 +1,4 @@
+obj-$(CONFIG_STAGE_KX070) += panel-kx070.o
 obj-$(CONFIG_STAGE_Y88249) += panel-y88249.o
 obj-$(CONFIG_STAGE_KD050HDFIA019) += panel-kd050hdfia019.o
 obj-$(CONFIG_STAGE_MA0060) += panel-ma0060.o
diff --git a/module_drivers/drivers/video/fbdev/ingenic/displays/panel-kx070.c b/module_drivers/drivers/video/fbdev/ingenic/displays/panel-kx070.c
new file mode 100644
--- /dev/null
+++ b/module_drivers/drivers/video/fbdev/ingenic/displays/panel-kx070.c
@@ -0,0 +1,75 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+
+#include "../include/ingenicfb.h"
+
+static struct fb_videomode kx070_mode = {
+	.name = "kx070",
+	.refresh = 45,
+	.xres = 480,
+	.yres = 800,
+	/* The SDK derives pixclock from refresh and the complete timings. */
+	.left_margin = 50,
+	.right_margin = 30,
+	.hsync_len = 10,
+	.upper_margin = 20,
+	.lower_margin = 20,
+	.vsync_len = 6,
+	.sync = 0,
+	.vmode = FB_VMODE_NONINTERLACED,
+};
+
+static struct jzdsi_data kx070_dsi = {
+	.modes = &kx070_mode,
+	/* Supported PHY/EPLL table entry, not the DPU pixel clock. */
+	.video_config.pixel_clock = 30000,
+	.video_config.color_coding = COLOR_CODE_24BIT,
+	.video_config.data_en_polarity = 0,
+	.video_config.h_polarity = 0,
+	.video_config.v_polarity = 0,
+};
+
+static struct tft_config kx070_tft = {
+	.pix_clk_inv = 0,
+	.de_dl = 0,
+	.sync_dl = 0,
+	.vsync_dl = 0,
+	.color_even = TFT_LCD_COLOR_EVEN_RGB,
+	.color_odd = TFT_LCD_COLOR_ODD_RGB,
+	.mode = TFT_LCD_MODE_PARALLEL_888,
+};
+
+static struct lcd_panel kx070_panel = {
+	.name = "kx070",
+	.num_modes = 1,
+	.modes = &kx070_mode,
+	.dsi_pdata = &kx070_dsi,
+	.lcd_type = LCD_TYPE_LVDS_VESA,
+	.bpp = 32,
+	.tft_config = &kx070_tft,
+};
+
+static int kx070_probe(struct platform_device *pdev)
+{
+	return ingenicfb_register_panel(&kx070_panel);
+}
+
+static const struct of_device_id kx070_of_match[] = {
+	{ .compatible = "ingenic,kx070" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, kx070_of_match);
+
+static struct platform_driver kx070_driver = {
+	.probe = kx070_probe,
+	.driver = {
+		.name = "kx070",
+		.of_match_table = kx070_of_match,
+	},
+};
+module_platform_driver(kx070_driver);
+
+MODULE_DESCRIPTION("Creator5Pro KX070 LVDS panel");
+MODULE_LICENSE("GPL");
diff --git a/module_drivers/drivers/video/fbdev/ingenic/fb_stage/dpu_ctrl.c b/module_drivers/drivers/video/fbdev/ingenic/fb_stage/dpu_ctrl.c
--- a/module_drivers/drivers/video/fbdev/ingenic/fb_stage/dpu_ctrl.c
+++ b/module_drivers/drivers/video/fbdev/ingenic/fb_stage/dpu_ctrl.c
@@ -888,12 +888,25 @@
 	uint32_t lcd_cgu;
 
 	lcd_cgu = *(volatile unsigned int *)(0xb0000064);
+#ifdef CONFIG_SOC_X2600
+	/* A plain LPCDR write wedges the X2600 pixel clock on cold boot. */
+	if (!!(lcd_cgu & (0x1 << 26)) != !!tft_config->pix_clk_inv) {
+		int t = 10000;
+
+		lcd_cgu ^= (0x1 << 26);
+		*(volatile unsigned int *)(0xb0000064) = lcd_cgu | (0x1 << 29);
+		while ((*(volatile unsigned int *)(0xb0000064) & (0x1 << 28)) && --t)
+			udelay(1);
+		*(volatile unsigned int *)(0xb0000064) = lcd_cgu & ~(0x1 << 29);
+	}
+#else
 	if (tft_config->pix_clk_inv) {
 		lcd_cgu |= (0x1 << 26);
 	} else {
 		lcd_cgu &= ~(0x1 << 26);
 	}
 	*(volatile unsigned int *)(0xb0000064) = lcd_cgu;
+#endif
 
 	tft_cfg = reg_read(dctrl, DC_TFT_CFG);
 	if (tft_config->de_dl) {
@@ -1284,18 +1297,20 @@
 	struct clk *pclk_parent;
 	int i = 0;
 	pclk_rate =  dctrl->panel->dsi_pdata->video_config.pixel_clock * 1000;
-	for (i = 0; i < sizeof(pclk_epll_tab) / sizeof(struct x2600_lvds_pclk_param); i++) {
+	for (i = 0; i < ARRAY_SIZE(pclk_epll_tab); i++) {
 		if (pclk_rate == pclk_epll_tab[i].pclk_freq) {
 			break;
 		}
 	}
-	if (i < 0) {
+	if (i == ARRAY_SIZE(pclk_epll_tab)) {
 		printk("ERROR: cannot get pclk epll param \n");
 		return -1;
 	}
 	pclk_parent = clk_get(NULL, "epll");
 	clk_set_rate(pclk_parent, pclk_epll_tab[i].pll_freq);
 	clk_set_parent(clk_get(NULL, "mux_lcd"), pclk_parent);
+	/* The PHY table selects EPLL; the active mode sets the DPU divider. */
+	pclk_rate = PICOS2KHZ(dctrl->active_video_mode->pixclock) * 1000;
 	clk_set_rate(dctrl->pclk, pclk_rate);
 	return 0;
 #else
@@ -1362,6 +1377,11 @@
 
 int dpu_ctrl_rdma_change(struct dpu_ctrl *dctrl, int frame)
 {
+	/* fbcon can pan before probe has configured and started the DPU. */
+	if (!dctrl->work_in_rdma) {
+		dctrl->rdma_last_frame = frame;
+		return 0;
+	}
 	/* TODO: 可能改变的内容，包括格式，大小等。这里只是切换frame, 什么时候真正切换还不一定.*/
 
 	/*如果此时正处于直通显示, 需要停止直通，切换到rdma通道.*/
